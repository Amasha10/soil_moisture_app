# Local MongoDB or MongoDB Atlas connection string
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=soil_monitor

# Must match DEVICE_API_KEY in the ESP32 sketch (firmware/soil_moisture_monitor/secrets.h)
DEVICE_API_KEY=change-this-device-key

# Alert rules
DEFAULT_THRESHOLD=30
HYSTERESIS=5
REMINDER_HOURS=3
OFFLINE_AFTER_MINUTES=15

# Optional: only if "Enhanced push security" is enabled in your Expo project
# EXPO_ACCESS_TOKEN=

CORS_ORIGINS=*
