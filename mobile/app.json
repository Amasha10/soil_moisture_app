{
  "expo": {
    "name": "Soil Moisture",
    "slug": "soil-moisture-monitor",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.dotailabs.soilmoisture",
      "googleServicesFile": "./google-services.json"
    },
    "ios": {
      "bundleIdentifier": "com.dotailabs.soilmoisture"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#2E7D32"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_YOUR_EAS_PROJECT_ID"
      }
    }
  }
}
